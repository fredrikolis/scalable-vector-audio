#!/usr/bin/env bash
# Concern: the gate declarations for this repo | Non-concern: how a gate is checked (git-agent-verdict owns that) or what a reviewer judges | IO: (message, tool version) -> status, edited message

# Line order IS review order: `set -e` stops at the first unattested gate.
set -euo pipefail

git agent-verdict --require-version 2.0

git agent-verdict "$1" standards --model sonnet \
  --standard programming --standard testing --standard cli \
  --rule "A builtin exists only when performance needs native code; complexity alone goes in online registries." \
  --rule $'Engine math is exact or carries a proven error bound that is stated in the code and reported to the caller; never an unproven or silent approximation. Fidelity is never traded for caching or speed, except with the following approved exceptions:\n- A read at a constant time shift (`@x(t - d)`, including beat onsets and humanise offsets) reads the sample nearest t - d at the render rate, ties to even; the largest move is reported per render as `moved_s`.\n- A render read over an interval with no end of its own ends at the first sample from which a proven bound on its root\'s magnitude over every later instant is below -120 dBFS; no other value is cut, so a closed interval renders exactly. The threshold is a profile setting (default -120 dBFS) and each render reports the level and where it ended.\n- A stream\'s note leaves the note sum once the summed bounds of all notes it has retired early, times a proven bound on the gain from the note sum to the stream\'s output, stay below the same level.\n- A live stream read past its position starts each stateful value silent there, with no state from before, and names it in `dropped`, as a live edit does.\n- Lines above the profile\'s audible ceiling (its `ceiling_hz`, 20 kHz by default, or the rate\'s Nyquist if lower) are not rendered.' \
  --rule $'The code keeps these concerns architecturally segregated:\n- Meaning (AST, typing): what an expression denotes.\n- Evaluation (render, optimisation, caching): computes meaning.\n- Policy (lint, budgets): cost and style, surfaced to authors as warnings or errors.\n\nExample violations:\n- Typing refuses `@x(0.5*t)` on a sampled node because the read costs a reconstruction.\n- Render silently rounds `self(t - 17ms)` to a whole number of samples.\n- Typing refuses `@kick(t - 0.1234s)` because render only reads whole samples.\n- `@piano(t - 4s)` renders different bits from cache than computed fresh.' \
  --rule "Any change to the bytes the persistent cache stores bumps its format version in the same commit." \
  --rule "A cache key depends only on what a value computes: never on names, file paths, comments, whitespace, argument order or position." \
  --rule "An edit produces a new version that shares every unchanged node; there is no separate static or live mode." \
  --rule "Strict separation of concerns: each layer talks only to the layer directly below it and never decides another layer's policy; evaluation never decides how or where anything is stored, and storage tiers are never skipped." \
  --rule "No test asserts on wall-clock time." \
  --rule "An analysis that follows refs is a per-node fold over the node graph, stored per node; never a recursion per path." \
  --rule "State that can disagree is refactored to one canonical owner and derived, never kept in sync; a cache is still compliant with this rule if every source change evicts it." \
  --path .

git agent-verdict "$1" standards --model sonnet \
  --standard human-communication --path README.md
