#!/usr/bin/env bash
# Concern: runs the per-commit gates | Non-concern: what any gate checks (the tools themselves), the attestation (git-agent-verdict) | IO: (the tree) -> exit 0, or the first gate's own failure

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
comment-crusher --config .comment-crusher.toml .
annotated-tree --strict-check --include-tests --hidden .
cargo test --workspace --quiet
